# Copy to .env and adjust. docker-compose.yml reads these automatically.
NE_EMIS_ENV=development

# Secret key used to sign JWTs — generate with:
#   openssl rand -hex 32
# PRODUCTION REQUIREMENT: when NE_EMIS_ENV=production the key MUST be ≥32 chars
# and must not be a placeholder ('change-me', 'admin1234', 'insecure', …).
NE_EMIS_SECRET_KEY=change-me-in-production-09f8c2a1b7e64d3a9f5c8e2d1a0b7f64
NE_EMIS_ALGORITHM=HS256
NE_EMIS_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite (default, zero-config):
NE_EMIS_DATABASE_URL=sqlite:///./ne_emis.db
# PostgreSQL (run `docker compose --profile db up` first):
# NE_EMIS_DATABASE_URL=postgresql+psycopg://neemis:neemis@db:5432/neemis

# JSON array of allowed CORS origins.
# PRODUCTION: must be explicit https:// origins — '*' and http:// are rejected.
NE_EMIS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Example production value:
# NE_EMIS_CORS_ORIGINS=["https://emis.yourschool.edu"]

# Security headers (optional overrides)
# Defaults to the strict "default-src 'self'" in production and a relaxed
# (HMR/fonts) policy in development.
# NE_EMIS_CONTENT_SECURITY_POLICY="default-src 'self'"
NE_EMIS_HSTS_MAX_AGE=31536000

# Rate limiting (slowapi) — login attempts per client IP
NE_EMIS_RATE_LIMIT_ENABLED=true
NE_EMIS_LOGIN_RATE_LIMIT=5/minute

# First-boot seed administrator
NE_EMIS_SEED_ADMIN_EMAIL=admin@neemis.edu
NE_EMIS_SEED_ADMIN_PASSWORD=admin1234
