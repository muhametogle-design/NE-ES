# =============================================================================
# NE-ES (NE-EMIS) — environment template
#   cp .env.example .env   then adjust the secrets before deploying.
#
# Target database: PostgreSQL 16 via psycopg2
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# =============================================================================

# --- database ---------------------------------------------------------------
# Primary connection string. `postgres://` and `postgresql://` are accepted and
# normalised to `postgresql+psycopg2://` automatically.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ne_es_dev

# Alternative, if you prefer discrete parts (used only when DATABASE_URL is unset).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ne_es_dev
# POSTGRES_SSLMODE=prefer        # managed databases (RDS/Cloud SQL/Supabase): require

# Connection pool (PostgreSQL only). Defaults match the production profile.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# Connection tuning
DB_CONNECT_TIMEOUT=10            # seconds to wait for a TCP connection
DB_STATEMENT_TIMEOUT_MS=0        # 0 = inherit the server default
DB_APPLICATION_NAME=ne-es-api    # shows up in pg_stat_activity

# Schema bootstrap. Leave unset: Alembic owns the schema in production,
# create_all() is used automatically in development/test only.
# DB_AUTO_CREATE_SCHEMA=true

# --- application ------------------------------------------------------------
APP_ENV=development              # development | test | production
APP_NAME=NE-EMIS
CORS_ORIGINS_RAW=*
COOKIE_SAMESITE=lax
COOKIE_SECURE=auto               # auto | true | false
PLATFORM_TIMEZONE=Africa/Nairobi

# --- security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# --- webauthn / biometrics --------------------------------------------------
WEBAUTHN_RP_ID=auto
WEBAUTHN_EXPECTED_ORIGINS=auto

# --- schedulers -------------------------------------------------------------
AUTO_SEED_DEMO=true
ENABLE_SCHEDULER=true
ATTENDANCE_DEADLINE=12:00
ALARM_AUDIT_TIME=15:00

# --- backups ----------------------------------------------------------------
BACKUP_TIME=00:00
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=30
ENABLE_BACKUP_SCHEDULER=true
BACKUP_ENCRYPTION_KEY=
